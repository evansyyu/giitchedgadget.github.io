---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
---

<Layout title="CV">
	<div class="min-h-screen flex flex-col">
		<Navbar />
		<main class="flex-1 flex flex-col items-center py-8 md:py-12 px-4">
			<div class="w-full max-w-2xl space-y-8">
				<section>
					<h2 class="font-refrigerator font-light text-2xl text-center underline text-[#333] dark:text-neutral-200 mb-4">
						Experience
					</h2>
					<p class="font-refrigerator font-light text-xl md:text-2xl text-center text-[#333] dark:text-neutral-200 leading-loose">
						Roblox Studio | 2019-present <br />
						Blender | 2019-present <br />
						Adobe Substance Painter | 2022-present
					</p>
				</section>
				<section>
					<h2 class="font-refrigerator font-light text-2xl text-center underline text-[#333] dark:text-neutral-200 mb-4">
						Work
					</h2>
					<p class="font-refrigerator font-light text-xl md:text-2xl text-center text-[#333] dark:text-neutral-200 leading-loose">
						Freelance | 2021-present <br />
						Spacelink | UGC Creator | 2023-present <br />
						Left 4 Death | Modeler | 2023-present <br />
						Tower Defense X | Contractor | 2022-2023 <br />
						Strike Down | Modeler | 2022-2023 <br />
						Frontline Interactive | Contractor | 2021-2022 <br />
						Tiny Towers | Contractor | 2021-2022 <br />
						Reconnaissance Games | Modeler | 2021-2022 <br />
						Frontline Defense | Modeler | 2021-2022 <br />
						Paradoxum Games | Contributor | 2020-2021 <br />
						Tower Defense Simulator | Contributor | 2020-2021
					</p>
				</section>
			</div>
		</main>
	</div>
</Layout>
