---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import WorkGallery from '../../components/work/WorkGallery.astro';

const assetModules = import.meta.glob<{ default: { src: string } | string }>('../../assets/work/2022/*', { eager: true });
const assetUrls: Record<string, string> = {};
for (const path in assetModules) {
	const name = path.replace(/^.*\//, '');
	const mod = assetModules[path].default;
	assetUrls[name] = typeof mod === 'string' ? mod : mod.src;
}

const items = [
	{ type: 'image' as const, src: 'toxic studio front.png', alt: 'Toxic studio front' },
	{ type: 'image' as const, src: 'toxic studio back.png', alt: 'Toxic studio back' },
	{ type: 'image' as const, src: 'toxic studio guns.png', alt: 'Toxic studio guns' },
	{ type: 'image' as const, src: 'toxic studio guns 2.png', alt: 'Toxic studio guns 2' },
	{ type: 'image' as const, src: 'toxic blender front.png', alt: 'Toxic blender front' },
	{ type: 'image' as const, src: 'toxic blender back.png', alt: 'Toxic blender back' },
	{ type: 'image' as const, src: 'riot.png', alt: 'Riot' },
	{ type: 'image' as const, src: 'military thingies blender.png', alt: 'Military thingies blender' },
	{ type: 'image' as const, src: 'sd lobby.jpg', alt: 'SD lobby' },
	{ type: 'image' as const, src: 'sd units blender front.png', alt: 'SD units blender front' },
	{ type: 'image' as const, src: 'sd units blender back.png', alt: 'SD units blender back' },
	{ type: 'image' as const, src: 'thingies.png', alt: 'Thingies' },
	{
		type: 'video' as const,
		src: 'space milk.mp4',
		href: 'https://www.instagram.com/p/B6n1JNLlnSY/',
		caption: 'Reference: fresh_bobatae',
	},
	{
		type: 'video' as const,
		src: 'orange juice.mp4',
		href: 'https://levimagony.gumroad.com/l/nqyfkt?layout=profile',
		caption: 'Reference: Levi Magony',
	},
	{
		type: 'video' as const,
		src: 'water.mp4',
		href: 'https://www.instagram.com/p/CEFP5DHF8kU/',
		caption: 'Reference: fresh_bobatae',
	},
];
---

<Layout title="成果。">
	<div class="min-h-screen flex flex-col">
		<Navbar />
		<main class="flex-1 flex justify-center">
			<WorkGallery items={items} year="2022" assetUrls={assetUrls} />
		</main>
	</div>
</Layout>
