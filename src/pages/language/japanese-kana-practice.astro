---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
---

<Layout title="Japanese Kana Practice">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400&family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet" slot="head" />
  <div id="pageWrap" class="flex h-dvh flex-col overflow-hidden">
    <Navbar />
    <main class="practice-page flex min-h-0 flex-1 flex-col items-center overflow-hidden px-4 gap-8 lg:gap-10 xl:gap-12 font-['Roboto',sans-serif]">
      <h1 class="text-2xl lg:text-3xl xl:text-4xl font-normal text-[#333] dark:text-neutral-200">Japanese Kana Practice</h1>

      <!-- Practice card -->
      <div id="card" class="relative w-full max-w-2xl lg:max-w-3xl xl:max-w-4xl bg-neutral-100 dark:bg-neutral-800 rounded-2xl px-6 md:px-10 lg:px-12 xl:px-14 py-2 md:py-4 flex flex-col items-center gap-4 lg:gap-6 min-h-[420px] lg:min-h-[480px]">
        <div class="flex flex-col items-center gap-2 lg:gap-4 mt-4 lg:mt-6">
          <p id="word" class="text-5xl md:text-6xl text-[#333] dark:text-neutral-100 font-['Noto_Serif_JP',serif]"></p>
          <p id="definition" class="text-lg lg:text-xl text-neutral-600 dark:text-neutral-400 text-center"></p>
        </div>

        <!-- Answer feedback -->
        <div id="answerBox" class="hidden w-full max-w-md lg:max-w-lg rounded-xl py-4 px-5 lg:py-5 lg:px-6 text-center lg:my-2">
          <p id="result" class="text-xl lg:text-2xl font-bold text-white"></p>
          <p id="correctAnswer" class="text-lg lg:text-xl text-white/90 mt-2 lg:mt-3 font-medium"></p>
        </div>

        <!-- Input -->
        <div class="w-full max-w-md lg:max-w-lg flex flex-col items-center mt-auto">
          <input
            type="text"
            id="textbox"
            autocomplete="off"
            class="w-full text-center text-lg lg:text-xl py-2 lg:py-3 px-5 rounded-full border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-700 text-[#333] dark:text-neutral-100 outline-none focus:ring-2 focus:ring-neutral-400 dark:focus:ring-neutral-500 transition"
          />
          <p id="bottom" class="hidden text-base lg:text-xl text-neutral-500 dark:text-neutral-400">Press any key to continue</p>
        </div>

        <button
          id="optionsBtn"
          type="button"
          class="text-sm lg:text-base py-2 px-4 lg:py-2.5 lg:px-5 rounded-xl bg-neutral-200 dark:bg-neutral-700 text-[#333] dark:text-neutral-200 hover:bg-neutral-300 dark:hover:bg-neutral-600 transition"
        >Options</button>
      </div>

      <!-- Options panel -->
      <div id="optionsPanel" class="hidden w-full max-w-2xl lg:max-w-3xl xl:max-w-4xl bg-neutral-100 dark:bg-neutral-800 rounded-2xl p-6 md:p-8 lg:p-10 xl:p-12">
        <h2 class="text-xl lg:text-2xl font-normal text-center text-[#333] dark:text-neutral-200 mb-6 lg:mb-8">Options</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-6 lg:gap-8 text-sm lg:text-base text-[#333] dark:text-neutral-200">
          <!-- Display mode -->
          <div>
            <p class="font-medium mb-2 text-base lg:text-lg">Display</p>
            <label class="flex items-center gap-2 mb-1.5"><input type="checkbox" id="showHiragana" checked class="accent-neutral-600 w-4 h-4" />Hiragana</label>
            <label class="flex items-center gap-2 mb-1.5"><input type="checkbox" id="showKatakana" checked class="accent-neutral-600 w-4 h-4" />Katakana</label>
            <hr class="my-3 border-neutral-300 dark:border-neutral-600" />
            <p class="font-medium mb-2 text-base lg:text-lg">Filters</p>
            <label class="flex items-center gap-2 mb-1.5"><input type="checkbox" id="showDakuten" checked class="accent-neutral-600 w-4 h-4" />Dakuten</label>
            <label class="flex items-center gap-2 mb-1.5"><input type="checkbox" id="showHandakuten" checked class="accent-neutral-600 w-4 h-4" />Handakuten</label>
          </div>
          <!-- Kana rows -->
          <div>
            <p class="font-medium mb-2 text-base lg:text-lg">Rows</p>
            <label class="flex items-center gap-2 mb-1.5"><input type="checkbox" data-row="あ" checked class="accent-neutral-600 w-4 h-4" />あ row</label>
            <label class="flex items-center gap-2 mb-1.5"><input type="checkbox" data-row="か" checked class="accent-neutral-600 w-4 h-4" />か row</label>
            <label class="flex items-center gap-2 mb-1.5"><input type="checkbox" data-row="さ" checked class="accent-neutral-600 w-4 h-4" />さ row</label>
            <label class="flex items-center gap-2 mb-1.5"><input type="checkbox" data-row="た" checked class="accent-neutral-600 w-4 h-4" />た row</label>
            <label class="flex items-center gap-2 mb-1.5"><input type="checkbox" data-row="な" checked class="accent-neutral-600 w-4 h-4" />な row</label>
            <label class="flex items-center gap-2 mb-1.5"><input type="checkbox" data-row="は" checked class="accent-neutral-600 w-4 h-4" />は row</label>
          </div>
          <div>
            <p class="font-medium mb-2 text-base">&nbsp;</p>
            <label class="flex items-center gap-2 mb-1.5"><input type="checkbox" data-row="ま" checked class="accent-neutral-600 w-4 h-4" />ま row</label>
            <label class="flex items-center gap-2 mb-1.5"><input type="checkbox" data-row="ら" checked class="accent-neutral-600 w-4 h-4" />ら row</label>
            <label class="flex items-center gap-2 mb-1.5"><input type="checkbox" data-row="や" checked class="accent-neutral-600 w-4 h-4" />や row</label>
            <label class="flex items-center gap-2 mb-1.5"><input type="checkbox" data-row="ん" checked class="accent-neutral-600 w-4 h-4" />ん row</label>
            <label class="flex items-center gap-2 mb-1.5"><input type="checkbox" data-row="ゐ" checked class="accent-neutral-600 w-4 h-4" />ゐ row</label>
          </div>
        </div>
        <div class="flex justify-center mt-6 lg:mt-8">
          <button id="optionsBack" type="button" class="text-sm lg:text-base py-2 px-6 rounded-xl bg-neutral-200 dark:bg-neutral-700 text-[#333] dark:text-neutral-200 hover:bg-neutral-300 dark:hover:bg-neutral-600 transition">Back</button>
        </div>
      </div>
    </main>
  </div>
</Layout>

<script>
  import { あ, か, さ, た, な, は, ま, ら, や, ん, ゐ } from "../../data/kana/kanaList";
  import { SRSEngine } from "../../lib/srs";

  type Kana = { hiragana: string; katakana: string; eng: string; dakuten: boolean; handakuten: boolean };

  const ROWS: Record<string, Kana[]> = { あ, か, さ, た, な, は, ま, ら, や, ん, ゐ };

  const wordEl = document.getElementById("word")!;
  const defEl = document.getElementById("definition")!;
  const answerBox = document.getElementById("answerBox")!;
  const resultEl = document.getElementById("result")!;
  const correctEl = document.getElementById("correctAnswer")!;
  const textbox = document.getElementById("textbox") as HTMLInputElement;
  const bottomEl = document.getElementById("bottom")!;
  const optionsBtn = document.getElementById("optionsBtn")!;
  const optionsPanel = document.getElementById("optionsPanel")!;
  const optionsBack = document.getElementById("optionsBack")!;
  const showHiragana = document.getElementById("showHiragana") as HTMLInputElement;
  const showKatakana = document.getElementById("showKatakana") as HTMLInputElement;
  const showDakuten = document.getElementById("showDakuten") as HTMLInputElement;
  const showHandakuten = document.getElementById("showHandakuten") as HTMLInputElement;
  const pageWrap = document.getElementById("pageWrap")!;
  const practiceMain = document.querySelector("main.practice-page") as HTMLElement;

  function setPracticeScrollLocked(locked: boolean) {
    if (locked) {
      document.documentElement.style.overflow = "hidden";
      document.body.style.overflow = "hidden";
      pageWrap.style.removeProperty("height");
      pageWrap.style.removeProperty("min-height");
      pageWrap.style.removeProperty("overflow");
      practiceMain.style.removeProperty("overflow");
      window.scrollTo(0, 0);
    } else {
      document.documentElement.style.overflow = "";
      document.body.style.overflow = "";
      pageWrap.style.height = "auto";
      pageWrap.style.minHeight = "100dvh";
      pageWrap.style.overflow = "visible";
      practiceMain.style.overflow = "visible";
    }
  }

  setPracticeScrollLocked(true);

  const srs = new SRSEngine<Kana>();

  function getPool(): Kana[] {
    const checks = document.querySelectorAll<HTMLInputElement>("[data-row]:checked");
    let pool: Kana[] = [];
    checks.forEach((c) => {
      const r = ROWS[c.dataset.row!];
      if (r) pool.push(...r);
    });
    if (!showDakuten.checked) pool = pool.filter((k) => !k.dakuten);
    if (!showHandakuten.checked) pool = pool.filter((k) => !k.handakuten);
    return pool;
  }

  function getDisplay(k: Kana): string {
    const hira = showHiragana.checked;
    const kata = showKatakana.checked;
    if (hira && kata) return Math.random() < 0.33 ? k.katakana : k.hiragana;
    if (kata) return k.katakana;
    return k.hiragana;
  }

  function getAnswers(eng: string): string | string[] {
    if (eng.includes(",")) return eng.split(",").map((s) => s.trim());
    return eng;
  }

  let currentHandler: ((e: KeyboardEvent) => void) | null = null;

  function nextCard() {
    const pool = getPool();
    if (pool.length === 0) return;
    textbox.disabled = false;
    textbox.value = "";
    textbox.focus();
    answerBox.classList.add("hidden");
    bottomEl.classList.add("hidden");
    textbox.hidden = false;

    const kana = srs.pick(pool)!;
    const answer = getAnswers(kana.eng);

    wordEl.textContent = getDisplay(kana);
    defEl.textContent = "Type the reading!";

    if (currentHandler) document.removeEventListener("keyup", currentHandler);
    currentHandler = (e: KeyboardEvent) => {
      if (e.key !== "Enter") return;
      const val = textbox.value.toLowerCase();
      textbox.value = "";
      textbox.disabled = true;
      textbox.blur();
      textbox.hidden = true;
      answerBox.classList.remove("hidden");
      bottomEl.classList.remove("hidden");
      defEl.textContent = "";

      const isCorrect = Array.isArray(answer)
        ? answer.includes(val)
        : val === answer;

      if (isCorrect) {
        srs.correct(kana);
        answerBox.className = "w-full max-w-md rounded-xl py-3 px-5 text-center bg-emerald-500";
        resultEl.textContent = "Correct";
        correctEl.textContent = val + " ○";
      } else {
        srs.wrong(kana);
        answerBox.className = "w-full max-w-md rounded-xl py-3 px-5 text-center bg-red-500";
        resultEl.textContent = (val || "No answer") + " ×";
        correctEl.textContent = (Array.isArray(answer) ? answer.join(", ") : answer) + " ○";
      }
      document.removeEventListener("keyup", currentHandler!);
      currentHandler = null;

      const resetHandler = (ev: KeyboardEvent | MouseEvent) => {
        document.removeEventListener("keyup", resetHandler);
        document.removeEventListener("mouseup", resetHandler);
        nextCard();
      };
      document.addEventListener("keyup", resetHandler);
      document.addEventListener("mouseup", resetHandler);
    };
    document.addEventListener("keyup", currentHandler);
  }

  optionsBtn.addEventListener("click", () => {
    optionsPanel.classList.toggle("hidden");
    const panelOpen = !optionsPanel.classList.contains("hidden");
    textbox.disabled = panelOpen;
    setPracticeScrollLocked(!panelOpen);
    if (!panelOpen) textbox.focus();
  });
  optionsBack.addEventListener("click", () => {
    optionsPanel.classList.add("hidden");
    textbox.disabled = false;
    setPracticeScrollLocked(true);
    textbox.focus();
  });

  nextCard();
</script>
