			<img src={typeof discordIcon === 'string' ? discordIcon : discordIcon.src} alt="" class="w-8 h-8 block dark:invert transition-opacity duration-200 group-hover:opacity-60" />
		</button>
		<span class="popover absolute block top-full left-1/2 -translate-x-1/2 mt-1.5 py-2.5 px-5 rounded-[10px] bg-black text-[whitesmoke] font-mono z-[5] opacity-0 pointer-events-none transition-opacity duration-300 ease-in-out whitespace-nowrap" aria-live="polite">Copied!</span>
	</div>
	<button
		type="button"
		class="dark-mode-toggle group p-2 rounded-full border-0 cursor-pointer bg-transparent"
		aria-label="Toggle dark mode"
	>
		<img src={typeof sunIcon === 'string' ? sunIcon : sunIcon.src} alt="" class="sun-icon w-8 h-8 block dark:hidden transition-opacity duration-200 group-hover:opacity-60" aria-hidden="true" />
		<img src={typeof moonIcon === 'string' ? moonIcon : moonIcon.src} alt="" class="moon-icon w-8 h-8 hidden dark:block dark:invert transition-opacity duration-200 group-hover:opacity-60" aria-hidden="true" />
	</button>
