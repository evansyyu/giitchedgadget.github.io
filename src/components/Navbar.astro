					<li><a href="https://www.roblox.com/users/126989919/profile" target="_blank" rel="noopener noreferrer" class="block py-2 text-black dark:text-neutral-200 hover:text-gray-400 dark:hover:text-neutral-400 no-underline hover:underline text-2xl text-center">Roblox</a></li>
					<li><a href="https://enka.network/u/620288461/" target="_blank" rel="noopener noreferrer" class="block py-2 text-black dark:text-neutral-200 hover:text-gray-400 dark:hover:text-neutral-400 no-underline hover:underline text-2xl text-center">Enka</a></li>
				</ul>
			</li>
		</ul>
	</nav>
</div>

<!-- Desktop: full nav. Hidden below sm, visible from sm. -->
