</nav>

<script>
	const burger = document.getElementById('nav-burger');
	const overlay = document.getElementById('mobile-nav-overlay');
	if (burger && overlay) {
		burger.addEventListener('click', () => {
			const isOpen = burger.classList.toggle('open');
			burger.setAttribute('aria-expanded', String(isOpen));
			overlay.classList.toggle('open', isOpen);
			overlay.setAttribute('aria-hidden', String(!isOpen));
			document.body.classList.toggle('overflow-hidden', isOpen);
			document.documentElement.classList.toggle('overflow-hidden', isOpen);
			if (!isOpen) {
				overlay.querySelectorAll('.mobile-dropdown.open').forEach((el) => el.classList.remove('open'));
				overlay.querySelectorAll('.mobile-nav-trigger[aria-expanded="true"]').forEach((btn) => btn.setAttribute('aria-expanded', 'false'));
			}
		});
	}
	document.querySelectorAll('.mobile-nav-trigger').forEach((trigger) => {
		trigger.addEventListener('click', () => {
			const id = trigger.getAttribute('data-mobile-dropdown');
			const panel = id ? document.getElementById(id) : null;
			if (!panel) return;
			// Close any other open dropdowns so only one is open at a time
			overlay?.querySelectorAll('.mobile-dropdown.open').forEach((el) => {
				if (el !== panel) el.classList.remove('open');
			});
			overlay?.querySelectorAll('.mobile-nav-trigger[aria-expanded="true"]').forEach((btn) => {
				if (btn !== trigger) btn.setAttribute('aria-expanded', 'false');
			});
			const isExpanded = panel.classList.toggle('open');
			trigger.setAttribute('aria-expanded', String(isExpanded));
		});
	});

	// Discord copy: copy data-copy to clipboard, show "Copied!" popover briefly
	let discordPopoverTimeout: ReturnType<typeof setTimeout>;
	let discordCopyCooldownUntil = 0;
	const DISCORD_COPY_COOLDOWN_MS = 2500;
	document.querySelectorAll('.discord-copy-btn').forEach((btn: Element) => {
		btn.addEventListener('click', async () => {
			if (Date.now() < discordCopyCooldownUntil) return;
			const str = (btn as HTMLElement).getAttribute('data-copy') || '';
			const wrap = btn.closest('.discord-copy-wrap');
			const popover = wrap?.querySelector('.popover');
			try {
				await navigator.clipboard.writeText(str);
				discordCopyCooldownUntil = Date.now() + DISCORD_COPY_COOLDOWN_MS;
				if (popover) {
					popover.classList.remove('opacity-0');
					popover.classList.add('opacity-100');
					clearTimeout(discordPopoverTimeout);
					discordPopoverTimeout = setTimeout(() => {
						popover.classList.add('opacity-0');
						popover.classList.remove('opacity-100');
					}, 1500);
				}
			} catch (_) {}
		});
	});

	// Dark mode: toggle .dark on <html> and save to localStorage; 0.5s cooldown between toggles
	let darkModeCooldownUntil = 0;
	const DARK_MODE_COOLDOWN_MS = 500;
	document.querySelectorAll('.dark-mode-toggle').forEach((btn: Element) => {
		btn.addEventListener('click', () => {
			if (Date.now() < darkModeCooldownUntil) return;
			darkModeCooldownUntil = Date.now() + DARK_MODE_COOLDOWN_MS;
			const isDark = document.documentElement.classList.toggle('dark');
			localStorage.setItem('darkMode', isDark ? 'true' : 'false');
		});
	});
</script>
