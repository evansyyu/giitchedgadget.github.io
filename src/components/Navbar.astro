				<button type="button" class="mobile-nav-main-item mobile-nav-trigger font-refrigerator font-light text-[#333] dark:text-neutral-200 text-4xl py-2 text-center bg-transparent border-0 cursor-pointer hover:underline" aria-expanded="false" aria-controls="mobile-dropdown-elsewhere" data-mobile-dropdown="mobile-dropdown-elsewhere">Elsewhere</button>
