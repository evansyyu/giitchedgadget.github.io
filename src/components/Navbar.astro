---
import sunIcon from '../assets/icons/sun.svg';
import moonIcon from '../assets/icons/moon.svg';
import discordIcon from '../assets/icons/discord.svg';
---

<!-- Mobile: burger top left, logo top center (same y padding). Fixed so content never overlaps. -->
<header class="fixed top-0 left-0 right-0 z-50 w-full py-6 flex items-center justify-between px-6 sm:hidden bg-white dark:bg-neutral-900" aria-label="Mobile header">
	<button
		id="nav-burger"
		type="button"
		class="nav-burger shrink-0 w-8 h-[26px] border-0 bg-transparent p-0 cursor-pointer"
		aria-label="Toggle menu"
		aria-expanded="false"
	>
		<span></span>
		<span></span>
		<span></span>
	</button>
	<a
		href="/"
		class="absolute left-1/2 -translate-x-1/2 inline-block"
		aria-label="Home"
	>
		<img src="/logo.svg" alt="" class="h-10 w-auto block dark:invert" />
	</a>
	<div class="flex items-center gap-3 shrink-0 w-28 justify-end">
		<div class="relative discord-copy-wrap">
			<button
				type="button"
				class="discord-copy-btn group p-2 rounded-full border-0 cursor-pointer bg-transparent"
				aria-label="Copy Discord"
				data-copy="e1yyu"
			>
				<img src={typeof discordIcon === 'string' ? discordIcon : discordIcon.src} alt="" class="w-8 h-8 block dark:invert transition-opacity duration-200 group-hover:opacity-60" />
			</button>
			<span class="popover absolute block top-full left-1/2 -translate-x-1/2 mt-1.5 py-2.5 px-5 rounded-[10px] bg-black text-[whitesmoke] font-mono z-5 opacity-0 pointer-events-none transition-opacity duration-300 ease-in-out whitespace-nowrap" aria-live="polite">Copied!</span>
		</div>
		<button
			type="button"
			class="dark-mode-toggle group p-2 rounded-full border-0 cursor-pointer bg-transparent"
			aria-label="Toggle dark mode"
		>
			<img src={typeof sunIcon === 'string' ? sunIcon : sunIcon.src} alt="" class="sun-icon w-8 h-8 block dark:hidden transition-opacity duration-200 group-hover:opacity-60" aria-hidden="true" />
			<img src={typeof moonIcon === 'string' ? moonIcon : moonIcon.src} alt="" class="moon-icon w-8 h-8 hidden dark:block dark:invert transition-opacity duration-200 group-hover:opacity-60" aria-hidden="true" />
		</button>
	</div>
</header>

<!-- Mobile nav overlay: full screen below header, column of nav items, evenly spaced. Dropdowns toggle on tap. -->
<div
	id="mobile-nav-overlay"
	class="fixed inset-0 z-40 flex flex-col pt-24 pb-12 px-6 bg-white dark:bg-neutral-900 opacity-0 pointer-events-none transition-opacity duration-300 sm:hidden"
	aria-hidden="true"
>
	<nav class="flex-1 flex flex-col justify-evenly items-center min-h-0" aria-label="Mobile menu">
		<ul class="list-none m-0 p-0 flex flex-col justify-evenly items-center gap-4 flex-1 min-h-0 w-full max-w-md">
			<li class="flex flex-col gap-2 items-center">
				<a href="/" class="mobile-nav-main-item mobile-nav-link font-refrigerator font-light text-[#333] dark:text-neutral-200 text-4xl py-2 no-underline hover:underline text-center">Home</a>
			</li>
			<li class="flex flex-col gap-2 items-center">
				<button type="button" class="mobile-nav-main-item mobile-nav-trigger font-refrigerator font-light text-[#333] dark:text-neutral-200 text-4xl py-2 text-center bg-transparent border-0 cursor-pointer hover:underline" aria-expanded="false" aria-controls="mobile-dropdown-projects" data-mobile-dropdown="mobile-dropdown-projects">Projects</button>
				<ul id="mobile-dropdown-projects" class="mobile-dropdown list-none m-0 space-y-1 overflow-hidden max-h-0 opacity-0 transition-all duration-300 flex flex-col items-center" aria-label="Projects submenu">
