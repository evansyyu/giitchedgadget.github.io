				<li class="m-0"><a href="/work/2023" class="block py-3 px-4 text-black dark:text-neutral-200 hover:text-gray-400 dark:hover:text-neutral-400 no-underline hover:underline text-center text-xl">2023</a></li>
				<li class="m-0"><a href="/work/2022" class="block py-3 px-4 text-black dark:text-neutral-200 hover:text-gray-400 dark:hover:text-neutral-400 no-underline hover:underline text-center text-xl">2022</a></li>
				<li class="m-0"><a href="/work/2021" class="block py-3 px-4 text-black dark:text-neutral-200 hover:text-gray-400 dark:hover:text-neutral-400 no-underline hover:underline text-center text-xl">2021</a></li>
