---
import '../styles/global.css';
interface Props {
	title?: string;
}
const { title = 'Astro' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/logo.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<slot name="head" />
		<script is:inline>
			const stored = localStorage.getItem('darkMode');
			if (stored === 'true' || (stored === null && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark');
			}
		</script>
	</head>
	<body class="font-refrigerator font-light bg-white text-neutral-900 dark:bg-neutral-900 dark:text-neutral-100 transition-colors">
		<slot />
	</body>
</html>
