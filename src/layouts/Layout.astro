---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
interface Props {
	title?: string;
	iconLightHref?: string;
	iconLightType?: string;
	iconDarkHref?: string;
	iconDarkType?: string;
	appleTouchIconHref?: string;
}
const {
	title = 'Astro',
	iconLightHref = '/logo.svg',
	iconLightType = 'image/svg+xml',
	iconDarkHref = '/logo-inverted.svg',
	iconDarkType = 'image/svg+xml',
	appleTouchIconHref = '/logo.svg',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type={iconLightType} href={iconLightHref} media="(prefers-color-scheme: light)" />
		<link rel="icon" type={iconDarkType} href={iconDarkHref} media="(prefers-color-scheme: dark)" />
		<link rel="icon" type={iconLightType} href={iconLightHref} />
		<link rel="apple-touch-icon" href={appleTouchIconHref} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<slot name="head" />
		<script is:inline>
			const stored = localStorage.getItem('darkMode');
			if (stored === 'true' || (stored === null && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark');
			}
		</script>
	</head>
	<body class="font-refrigerator font-light bg-white text-neutral-900 dark:bg-neutral-900 dark:text-neutral-100 transition-colors">
		<slot />
		<Analytics />
	</body>
</html>
